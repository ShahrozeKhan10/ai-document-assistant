# Copy this file to .env and fill in the values. .env is in .gitignore - never commit it.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, a number and a symbol.
SA_PASSWORD=Change_Me_123!

# From https://aistudio.google.com (Get API key)
GEMINI_API_KEY=

# Any random string of at least 32 characters, used to sign login tokens.
JWT_KEY=
