{
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=DocAssistant;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Chunking": {
    "ChunkSize": 1000,
    "ChunkOverlap": 200
  },
  "Storage": {
    "RootPath": "storage",
    "MaxFileSizeMb": 20
  },
  "Gemini": {
    "ApiKey": "",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "EmbeddingModel": "gemini-embedding-001",
    "EmbeddingDimensions": 768,
    "EmbeddingBatchSize": 50,
    "ChatModel": "gemini-3.6-flash"
  },
  "Qdrant": {
    "Url": "http://localhost:6333/",
    "Collection": "document_chunks"
  },
  "Rag": {
    "TopK": 5,
    "MinScore": 0.0
  },
  "Jwt": {
    "Issuer": "DocAssistant",
    "Audience": "DocAssistant",
    "Key": "",
    "ExpiresMinutes": 120
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
